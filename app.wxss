page {
  background: #f5f6f8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #202124;
  font-size: 28rpx;
  line-height: 1.5;
}

.card {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #202124;
  display: flex;
  align-items: center;
}

.btn-primary {
  display: block;
  width: 100%;
  background: linear-gradient(135deg, #ff7a4a, #ff5a20);
  color: #fff;
  border: none;
  border-radius: 56rpx;
  padding: 28rpx 0;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  letter-spacing: 2rpx;
  transition: opacity 0.15s;
}
.btn-primary:active { opacity: 0.85; }

.btn-ghost {
  flex: 1;
  text-align: center;
  border: 2rpx solid #dadce0;
  color: #5f6368;
  border-radius: 44rpx;
  padding: 18rpx 0;
  font-size: 26rpx;
  background: #fff;
  transition: background 0.15s;
}
.btn-ghost:active { background: #f5f6f8; }

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  line-height: 1.4;
}

.tag-orange { background: #fff1eb; color: #ff6b35; }
.tag-blue { background: #e8f0fe; color: #1967d2; }
.tag-green { background: #e6f4ea; color: #1e8e3e; }
.tag-gray { background: #f1f3f4; color: #5f6368; }
.tag-pink { background: #fce4ec; color: #c2185b; }
.tag-red { background: #ffebee; color: #c62828; }

.ptype-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
  display: inline-block;
}
.ptype-small { background: #f1f3f4; color: #5f6368; }
.ptype-mid { background: #fff1eb; color: #ff6b35; }
.ptype-big { background: #ffebee; color: #c62828; }
.ptype-urgent { background: #fce4ec; color: #c2185b; }

.price {
  color: #ff6b35;
  font-weight: 600;
}

.hl { color: #ff6b35; font-weight: 700; }

.empty {
  text-align: center;
  padding: 200rpx 80rpx calc(200rpx + env(safe-area-inset-bottom));
}
.empty-emoji {
  font-size: 140rpx;
  display: block;
  margin-bottom: 32rpx;
  line-height: 1;
  filter: grayscale(0.2);
}
.empty-text {
  font-size: 30rpx;
  color: #202124;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #9aa0a6;
  display: block;
}

.btn-login-empty {
  width: 360rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #ff7a4a, #ff5a20);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 53, 0.3);
  margin: 48rpx auto 0;
  transition: transform 0.15s, box-shadow 0.15s;
}
.btn-login-empty:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.3);
}
