<view class="page">
  <block wx:if="{{!loggedIn}}">
    <view class="empty">
      <image class="empty-emoji" src="{{icons.shield_gray}}" mode="aspectFit" />
      <text class="empty-text">请先登录</text>
      <text class="empty-sub">登录后查看个人信息</text>
      <button class="btn-login-empty" bindtap="goLogin">立即登录</button>
    </view>
  </block>

  <block wx:else>
    <view class="profile-head">
      <image class="avatar-big" src="{{user.avatar || icons.user_white}}" mode="aspectFit" />
      <view class="ph-info">
        <view class="p-name">
          <text>{{user.nickname}}</text>
          <text wx:if="{{user.role === 'runner'}}" class="tag tag-orange">跑腿员</text>
          <text wx:elif="{{user.role === 'admin'}}" class="tag tag-blue">管理员</text>
          <text wx:else class="tag tag-green">发单用户</text>
        </view>
        <text class="p-sub">校园跑腿 · {{user.role === 'runner' ? '正在接单' : '随时发布订单'}}</text>
      </view>
    </view>

    <view class="stats-card">
      <view class="p-stat">
        <text class="p-stat-num">{{stats.publishCount}}</text>
        <text class="p-stat-lbl">发单数</text>
      </view>
      <view class="p-stat-sep"></view>
      <view class="p-stat">
        <text class="p-stat-num">{{stats.completeCount}}</text>
        <text class="p-stat-lbl">已完成</text>
      </view>
      <view class="p-stat-sep"></view>
      <view class="p-stat">
        <text class="p-stat-num">¥{{stats.totalEarn || 0}}</text>
        <text class="p-stat-lbl">总收入</text>
      </view>
    </view>

    <view wx:if="{{user.role === 'runner'}}" class="income-card">
      <view class="income-head">
        <view class="income-title">
          <image class="income-ic" src="{{icons.coins_orange}}" mode="aspectFit" />
          <text>收入统计</text>
        </view>
        <view class="income-tabs">
          <view class="itab {{incomePeriod === 'week' ? 'itab-active' : ''}}" data-period="week" bindtap="changePeriod">本周</view>
          <view class="itab {{incomePeriod === 'month' ? 'itab-active' : ''}}" data-period="month" bindtap="changePeriod">本月</view>
        </view>
      </view>
      <view class="income-main">
        <text class="income-amount">¥{{incomeAmount || 0}}</text>
        <text class="income-count">完成 {{incomeCount || 0}} 单</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">
        <image class="ci" src="{{icons.coins_orange}}" mode="aspectFit" />
        <text>跑腿费标准（平台统一定价）</text>
      </view>
      <view class="price-row">
        <text>小包裹（衣服/手机壳）</text>
        <text class="price">¥{{pricing.small}}</text>
      </view>
      <view class="price-row">
        <text>中包裹（鞋盒/书）</text>
        <text class="price">¥{{pricing.mid}}</text>
      </view>
      <view class="price-row">
        <text>大包裹（行李箱/大箱）</text>
        <text class="price">¥{{pricing.big}}</text>
      </view>
      <view class="price-row">
        <text>急件/特殊（易碎/生鲜）</text>
        <text class="price">¥{{pricing.urgent}}+</text>
      </view>
    </view>

    <view class="card">
      <view class="menu-item" wx:if="{{user.role !== 'runner'}}" bindtap="switchRole" data-role="runner">
        <image class="mi" src="{{icons.wrench_gray}}" mode="aspectFit" />
        <text class="mt">开发：切换为跑腿员视角</text>
        <image class="arr" src="{{icons.chevron_gray}}" mode="aspectFit" />
      </view>
      <view class="menu-item" wx:if="{{user.role === 'runner'}}" bindtap="switchRole" data-role="user">
        <image class="mi" src="{{icons.wrench_gray}}" mode="aspectFit" />
        <text class="mt">开发：切换为发单用户视角</text>
        <image class="arr" src="{{icons.chevron_gray}}" mode="aspectFit" />
      </view>
      <view class="menu-item" bindtap="goLegal">
        <image class="mi" src="{{icons.shield_gray}}" mode="aspectFit" />
        <text class="mt">服务协议与法律声明</text>
        <image class="arr" src="{{icons.chevron_gray}}" mode="aspectFit" />
      </view>
      <view class="menu-item" bindtap="logout">
        <image class="mi" src="{{icons.log_out_red}}" mode="aspectFit" />
        <text class="mt mt-danger">退出登录</text>
        <image class="arr" src="{{icons.chevron_gray}}" mode="aspectFit" />
      </view>
    </view>

    <view class="ver"><text>v1.0.0 · 校园跑腿</text></view>
  </block>
</view>
