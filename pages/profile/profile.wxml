<view class="page">
  <block wx:if="{{!loggedIn}}">
    <view class="empty">
      <text class="empty-emoji">🔐</text>
      <text class="empty-text">请先登录</text>
      <text class="empty-sub">登录后查看个人信息</text>
      <button class="btn-login-empty" bindtap="goLogin">立即登录</button>
    </view>
  </block>

  <block wx:else>
  <view class="profile-head">
    <view class="avatar-big">{{user.avatar}}</view>
    <view class="ph-info">
      <view class="p-name">
        {{user.nickname}}
        <text wx:if="{{user.role === 'runner'}}" class="tag tag-pink">跑腿员</text>
        <text wx:elif="{{user.role === 'admin'}}" class="tag tag-blue">管理员</text>
        <text wx:else class="tag tag-green">发单用户</text>
      </view>
      <view class="p-sub">{{user.phone}} · {{user.school}}</view>
    </view>
    <view class="ph-edit" bindtap="editProfile">⚙️</view>
  </view>

  <view class="stats-card">
    <view class="p-stat">
      <view class="p-stat-num">{{user.role === 'runner' ? user.stats.acceptCount : user.stats.publishCount}}</view>
      <view class="p-stat-lbl">{{user.role === 'runner' ? '累计接单' : '累计发单'}}</view>
    </view>
    <view class="p-stat-sep"></view>
    <view class="p-stat">
      <view class="p-stat-num">{{user.role === 'runner' ? (user.stats.rating || '-') : '-'}}</view>
      <view class="p-stat-lbl">{{user.role === 'runner' ? '综合评分' : '评价星级'}}</view>
    </view>
    <view class="p-stat-sep"></view>
    <view class="p-stat">
      <view class="p-stat-num">{{user.stats.completeCount}}</view>
      <view class="p-stat-lbl">已完成</view>
    </view>
  </view>

  <!-- 跑腿员收入统计 -->
  <view wx:if="{{isRunner && incomeData}}" class="income-card">
    <view class="income-head">
      <view class="income-title">💰 收入统计</view>
      <view class="income-tabs">
        <view class="itab {{incomePeriod === 'week' ? 'itab-active' : ''}}" bindtap="switchPeriod" data-p="week">本周</view>
        <view class="itab {{incomePeriod === 'month' ? 'itab-active' : ''}}" bindtap="switchPeriod" data-p="month">本月</view>
        <view class="itab {{incomePeriod === 'total' ? 'itab-active' : ''}}" bindtap="switchPeriod" data-p="total">累计</view>
      </view>
    </view>
    <view class="income-main">
      <view class="income-amount">¥{{incomeData.total}}</view>
      <view class="income-count">完成 {{incomeData.count}} 单</view>
    </view>
  </view>

  <view class="card" wx:if="{{!isRunner}}">
    <view class="card-title">💰 跑腿费标准（平台统一定价）</view>
    <view class="price-row">
      <view><text class="ptype-tag ptype-small">小</text> 衣服/零食/手机壳</view>
      <text class="price">¥{{pricing.small}}/件</text>
    </view>
    <view class="price-row">
      <view><text class="ptype-tag ptype-mid">中</text> 鞋盒/书/日用品</view>
      <text class="price">¥{{pricing.mid}}/件</text>
    </view>
    <view class="price-row">
      <view><text class="ptype-tag ptype-big">大</text> 行李箱/大箱子</view>
      <text class="price">¥{{pricing.big}}/件</text>
    </view>
    <view class="price-row">
      <view><text class="ptype-tag ptype-urgent">急</text> 易碎/生鲜/文件</view>
      <text class="price">¥{{pricing.urgent}}+/件</text>
    </view>
  </view>

  <view class="card">
    <view class="menu-item" bindtap="switchToRunner" wx:if="{{user.role !== 'runner'}}">
      <text class="mi">🔧</text><text class="mt">开发：切换为跑腿员视角</text><text class="arr">›</text>
    </view>
    <view class="menu-item" bindtap="switchToUser" wx:if="{{user.role !== 'user'}}">
      <text class="mi">🔧</text><text class="mt">开发：切换为发单用户视角</text><text class="arr">›</text>
    </view>
    <view class="menu-item" bindtap="logout">
      <text class="mi">🚪</text><text class="mt" style="color:#e53935">退出登录</text><text class="arr">›</text>
    </view>
  </view>

  <view class="ver">v0.6 · 校园跑腿</view>
  </block>
</view>