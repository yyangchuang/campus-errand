.page {
  padding-top: 0;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.profile-head {
  padding: 48rpx 28rpx 56rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #e55a2b 100%);
  color: #fff;
  position: relative;
  border-radius: 0 0 32rpx 32rpx;
  display: flex;
  align-items: center;
}

.avatar-big {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  border: none;
  padding: 20rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.ph-info {
  flex: 1;
  margin-left: 24rpx;
}

.p-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
}

.p-name .tag {
  margin-left: 10rpx;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: none;
}

.p-sub {
  font-size: 24rpx;
  opacity: 0.85;
}

.stats-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  margin: -24rpx 24rpx 20rpx;
  padding: 28rpx 0;
  border: 2rpx solid #e5e7eb;
  position: relative;
  z-index: 1;
}

.p-stat {
  flex: 1;
  text-align: center;
}

.p-stat-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2937;
  font-family: "DIN Alternate", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: -1rpx;
}

.p-stat-lbl {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
  display: block;
}

.p-stat-sep {
  width: 2rpx;
  height: 56rpx;
  background: #e5e7eb;
  align-self: center;
}

.income-card {
  background: #1f2937;
  border-radius: 20rpx;
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  color: #fff;
  border: 2rpx solid #374151;
}

.income-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.income-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
}

.income-ic {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.income-tabs {
  display: flex;
}

.itab {
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: #9ca3af;
  background: #374151;
  margin-left: 8rpx;
}

.itab-active {
  background: #ff6b35;
  color: #fff;
}

.income-main {
  padding-left: 4rpx;
}

.income-amount {
  font-size: 60rpx;
  font-weight: 800;
  font-family: "DIN Alternate", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: -1rpx;
  display: block;
}

.income-count {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  display: block;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  border: 2rpx solid #e5e7eb;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #374151;
  border-bottom: 2rpx solid #f3f4f6;
}

.price-row:last-child {
  border-bottom: none;
}

.price {
  font-size: 28rpx;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
  color: #ff6b35;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f3f4f6;
  font-size: 28rpx;
  color: #1f2937;
}

.menu-item:last-child {
  border-bottom: none;
}

.mi {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.mt {
  flex: 1;
}

.mt-danger {
  color: #ef4444;
}

.ver {
  text-align: center;
  font-size: 22rpx;
  color: #9ca3af;
  padding: 40rpx 0 20rpx;
}

.empty {
  text-align: center;
  padding: 200rpx 80rpx calc(200rpx + env(safe-area-inset-bottom));
}

.empty-text {
  font-size: 38rpx;
  color: #1f2937;
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.empty-sub {
  font-size: 26rpx;
  color: #9ca3af;
  display: block;
  margin-bottom: 40rpx;
}

.btn-login-empty {
  background: #ff6b35;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 20rpx 80rpx;
  display: inline-block;
  border: none;
  line-height: 1;
}

.btn-login-empty::after {
  border: none;
}
