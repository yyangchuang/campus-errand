.page { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }

/* ===== 未登录空状态（profile 独有字号覆盖） ===== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 80rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.empty-emoji {
  font-size: 200rpx;
  line-height: 1;
  margin-bottom: 48rpx;
  filter: grayscale(0.1);
}
.empty-text {
  font-size: 38rpx;
  color: #202124;
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}
.empty-sub {
  font-size: 26rpx;
  color: #9aa0a6;
  margin-bottom: 56rpx;
  display: block;
}

/* ===== 头部渐变卡 ===== */
.profile-head {
  background: linear-gradient(135deg, #ff7a4a 0%, #ff5a20 100%);
  color: #fff;
  padding: 96rpx 40rpx 120rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  border-radius: 0 0 48rpx 48rpx;
  position: relative;
  overflow: hidden;
}
.profile-head::before {
  content: '';
  position: absolute;
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  top: -200rpx;
  right: -120rpx;
}
.profile-head::after {
  content: '';
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  bottom: -100rpx;
  left: -60rpx;
}
.profile-head .avatar-big, .profile-head .ph-info, .profile-head .ph-edit { position: relative; z-index: 1; }
.ph-info { flex: 1; }
.ph-edit {
  position: absolute;
  top: 32rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  transition: background 0.15s, transform 0.15s;
}
.ph-edit:active { background: rgba(255, 255, 255, 0.4); transform: scale(0.92); }

.avatar-big {
  width: 144rpx;
  height: 144rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}
.p-name {
  font-size: 38rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.p-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

/* ===== 统计悬浮卡 ===== */
.stats-card {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  margin: -56rpx 24rpx 24rpx;
  padding: 36rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 2;
}
.p-stat { flex: 1; text-align: center; }
.p-stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #202124;
  letter-spacing: -1rpx;
}
.p-stat-lbl {
  font-size: 22rpx;
  color: #9aa0a6;
  display: block;
  margin-top: 8rpx;
}
.p-stat-sep {
  width: 2rpx;
  height: 56rpx;
  background: #e8eaed;
  align-self: center;
}

/* ===== 跑腿员收入卡 ===== */
.income-card {
  margin: 0 24rpx 24rpx;
  background: linear-gradient(135deg, #202124 0%, #3c4043 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}
.income-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.income-title { font-size: 28rpx; font-weight: 600; opacity: 0.9; }
.income-tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 100rpx;
  padding: 4rpx;
}
.itab {
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  border-radius: 100rpx;
  color: rgba(255, 255, 255, 0.6);
  transition: all 0.2s;
}
.itab-active {
  background: #fff;
  color: #202124;
  font-weight: 600;
}
.income-main { text-align: center; padding: 20rpx 0 8rpx; }
.income-amount {
  font-size: 80rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  line-height: 1.1;
}
.income-count {
  font-size: 24rpx;
  opacity: 0.6;
  margin-top: 12rpx;
}

/* ===== 通用卡片 ===== */
.card {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #202124;
  margin-bottom: 24rpx;
  display: block;
}

/* ===== 定价行 ===== */
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #3c4043;
  border-bottom: 2rpx solid #f5f6f8;
}
.price-row:last-child { border-bottom: none; }
.price {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff6b35;
}

/* ===== 菜单项 ===== */
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f5f6f8;
  font-size: 28rpx;
  transition: background 0.12s;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #fafbfc; }
.mi { font-size: 32rpx; margin-right: 20rpx; }
.mt { flex: 1; color: #202124; }

/* ===== 版本号 ===== */
.ver {
  text-align: center;
  color: #bdc1c6;
  font-size: 22rpx;
  padding: 48rpx 0 calc(48rpx + env(safe-area-inset-bottom));
}
