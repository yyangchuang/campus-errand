.page { padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }

.page-header {
  padding: 32rpx 32rpx 16rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #202124;
}
.page-sub {
  font-size: 24rpx;
  color: #9aa0a6;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 32rpx;
  border-bottom: 2rpx solid #f0f2f5;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tabs .tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #5f6368;
  position: relative;
  transition: color 0.15s;
}
.tabs .tab.active {
  color: #ff6b35;
  font-weight: 600;
}
.tabs .tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #ff6b35;
  border-radius: 4rpx;
}

.order-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 16rpx 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s, box-shadow 0.15s;
}
.order-card:active { transform: scale(0.995); box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08); }

.oc-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}
.oc-time { font-size: 22rpx; color: #9aa0a6; }
.oc-reward { font-size: 40rpx; color: #ff6b35; font-weight: 600; }

.oc-route {
  background: linear-gradient(135deg, #f8f9fa, #fafbfc);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  border: 2rpx solid #f0f2f5;
}
.route-r1 { margin-bottom: 6rpx; }
.dotg { color: #1e8e3e; font-size: 18rpx; margin-right: 12rpx; }
.doto { color: #ff6b35; font-size: 18rpx; margin-right: 12rpx; }

.oc-meta {
  font-size: 24rpx;
  color: #5f6368;
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  align-items: center;
}
.pkg-tags { display: flex; gap: 8rpx; }

.oc-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f6f8;
}
