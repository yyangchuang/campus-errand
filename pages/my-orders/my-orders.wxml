<view class="page">
  <block wx:if="{{!loggedIn}}">
    <view class="empty">
      <image class="empty-emoji" src="{{icons.shield_gray}}" mode="aspectFit" />
      <text class="empty-text">请先登录</text>
      <text class="empty-sub">登录后查看我的订单</text>
      <button class="btn-login-empty" bindtap="goLogin">立即登录</button>
    </view>
  </block>

  <block wx:else>
    <view class="page-header">
      <text class="page-title">{{roleLabel}}</text>
      <text class="page-sub">共 {{orderList.length}} 单</text>
    </view>

    <scroll-view class="tabs" scroll-x enable-flex scroll-with-animation>
      <view wx:for="{{filterTabs}}" wx:key="key"
            class="tab {{filterStatus === item.key ? 'active' : ''}}"
            data-key="{{item.key}}" bindtap="filterChange">
        <text>{{item.label}}</text>
      </view>
    </scroll-view>

    <block wx:if="{{filteredList.length === 0}}">
      <view class="empty">
        <image class="empty-emoji" src="{{icons.package_gray}}" mode="aspectFit" />
        <text class="empty-text">{{filterStatus === 'all' ? '还没有订单' : '当前状态下没有订单'}}</text>
        <text class="empty-sub">{{filterStatus === 'all' ? '去发布第一个订单吧' : '试试其他筛选条件'}}</text>
      </view>
    </block>

    <block wx:else>
      <view wx:for="{{filteredList}}" wx:key="id" class="order-card" bindtap="goDetail" data-id="{{item.id}}">
        <view class="oc-head">
          <view class="oc-tags">
            <text class="tag {{item.statusTag.cls}}">{{item.statusTag.label}}</text>
            <text wx:if="{{item.takeMode === 'assign'}}" class="tag tag-orange">派单</text>
          </view>
          <text class="oc-time">{{item.timeLabel}}</text>
        </view>
        <view class="oc-route">
          <view class="route-r1">
            <text class="doto">●</text>
            <text>{{item.stationName}}</text>
          </view>
          <view class="route-r2">
            <text class="dotg">●</text>
            <text>{{item.address}}</text>
          </view>
        </view>
        <view class="oc-meta">
          <text class="pkg-tags">
            <text wx:if="{{item.packages.length > 0}}" class="tag tag-gray">{{item.packages.length}}件</text>
          </text>
          <text wx:if="{{item.urgent}}" class="tag tag-orange">急件</text>
        </view>
        <view class="oc-foot">
          <text class="oc-reward">¥{{item.total}}</text>
          <text class="oc-detail">查看详情</text>
        </view>
      </view>
    </block>
  </block>
</view>
