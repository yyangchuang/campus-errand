<view class="page">
  <block wx:if="{{!loggedIn}}">
    <view class="empty">
      <image class="empty-emoji" src="{{icons.shield_gray}}" mode="aspectFit" />
      <text class="empty-text">请先登录</text>
      <text class="empty-sub">登录后查看待抢订单</text>
      <button class="btn-login-empty" bindtap="goLogin">立即登录</button>
    </view>
  </block>

  <block wx:else>
    <block wx:if="{{assignList.length > 0}}">
      <view class="section-label">
        <image class="sl-ic" src="{{icons.bell_orange}}" mode="aspectFit" />
        <text>派单给我（{{assignList.length}}）</text>
      </view>
      <view wx:for="{{assignList}}" wx:key="id" class="order-card assign-card" bindtap="goDetail" data-id="{{item.id}}">
        <view class="assign-badge">管理员派单</view>
        <view class="oc-head">
          <text class="oc-time">{{item.timeLabel}}</text>
          <text class="oc-reward">¥{{item.total}}</text>
        </view>
        <view class="oc-route">
          <view class="route-r1">
            <text class="doto">●</text>
            <text>{{item.stationName}}</text>
          </view>
          <view class="route-r2">
            <text class="dotg">●</text>
            <text>{{item.address}}</text>
          </view>
        </view>
        <view class="oc-meta">
          <text>共{{item.pkgCount}}件 · 取件码 {{item.firstCode}}+</text>
          <text wx:if="{{item.urgent}}" class="tag tag-orange">急件</text>
        </view>
        <view class="assign-actions">
          <button class="btn-reject" catchtap="rejectAssign" data-id="{{item.id}}">拒绝</button>
          <button class="btn-accept" catchtap="acceptAssign" data-id="{{item.id}}">接受</button>
        </view>
      </view>
    </block>

    <block wx:if="{{grabList.length > 0}}">
      <view class="section-label">
        <image class="sl-ic" src="{{icons.flame_orange}}" mode="aspectFit" />
        <text>可抢单（{{grabList.length}}）</text>
      </view>
      <view wx:for="{{grabList}}" wx:key="id" class="order-card" bindtap="goDetail" data-id="{{item.id}}">
        <view class="oc-head">
          <text class="oc-time">{{item.timeLabel}}</text>
          <text class="oc-reward">¥{{item.total}}</text>
        </view>
        <view class="oc-route">
          <view class="route-r1">
            <text class="doto">●</text>
            <text>{{item.stationName}}</text>
          </view>
          <view class="route-r2">
            <text class="dotg">●</text>
            <text>{{item.address}}</text>
          </view>
        </view>
        <view class="oc-meta">
          <text>共{{item.pkgCount}}件</text>
          <text wx:if="{{item.urgent}}" class="tag tag-orange">急件</text>
        </view>
        <button class="btn-grab" catchtap="grabOrder" data-id="{{item.id}}">立即抢单</button>
      </view>
    </block>

    <block wx:if="{{assignList.length === 0 && grabList.length === 0}}">
      <view class="empty">
        <image class="empty-emoji" src="{{icons.runner_gray}}" mode="aspectFit" />
        <text class="empty-text">暂无新订单</text>
        <text class="empty-sub">稍后再来看看吧</text>
      </view>
    </block>
  </block>
</view>
