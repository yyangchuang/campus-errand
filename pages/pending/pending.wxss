.page { padding-top: 48rpx; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }

.section-label {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 12rpx;
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 600;
}
.section-label .count { color: #ff6b35; font-weight: 500; margin-left: 4rpx; }

.order-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 12rpx 24rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #e5e7eb;
  transition: border-color 0.12s, background 0.12s;
}
.order-card:active { border-color: #ff6b35; background: #fff7f3; }

.assign-card { border: 2rpx solid #f59e0b; position: relative; background: #fffbeb; }
.assign-badge {
  position: absolute;
  top: -16rpx;
  left: 28rpx;
  background: #f59e0b;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.oc-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
}
.oc-time { font-size: 22rpx; color: #9ca3af; }
.oc-reward {
  font-size: 48rpx;
  color: #ff6b35;
  font-weight: 800;
  font-family: "DIN Alternate", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: -1rpx;
}

.oc-route {
  background: #fafbfc;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  border: 2rpx solid #f3f4f6;
}
.route-r1 { margin-bottom: 4rpx; }
.dotg { color: #22c55e; font-size: 16rpx; margin-right: 10rpx; }
.doto { color: #ff6b35; font-size: 16rpx; margin-right: 10rpx; }

.oc-meta {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 12rpx;
  display: flex;
flex-wrap: wrap;
  align-items: center;
}
.pkg-tags { display: flex; }

.oc-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f3f4f6;
}

.assign-actions {
  display: flex;
margin-top: 20rpx;
}
.btn-reject, .btn-accept {
  flex: 1;
  border-radius: 40rpx;
  padding: 18rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.12s;
}
.btn-reject {
  background: #fff;
  border: 2rpx solid #d1d5db;
  color: #6b7280;
}
.btn-reject:active { background: #f3f4f6; border-color: #9ca3af; }
.btn-accept {
  background: #f59e0b;
  color: #fff;
  border: none;
}
.btn-accept:active { background: #d97706; }

.btn-grab {
  margin-top: 16rpx;
  background: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 44rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: background 0.12s, transform 0.12s;
}
.btn-grab:active { background: #e55a2b; transform: scale(0.98); }
