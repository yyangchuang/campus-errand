.page { padding-bottom: 320rpx; }

.notice-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: #fff7f3;
  border-radius: 16rpx;
  border-left: 6rpx solid #ff6b35;
}
.nb-icon { font-size: 28rpx; flex-shrink: 0; }
.nb-text {
  flex: 1;
  font-size: 24rpx;
  color: #5f6368;
  line-height: 1.5;
}
.nb-close {
  color: #bdc1c6;
  font-size: 26rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background 0.15s, color 0.15s;
  flex-shrink: 0;
}
.nb-close:active { background: #ffe8dc; color: #ff6b35; }

.row-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
}
.arr { color: #bdc1c6; font-size: 32rpx; margin-left: 16rpx; flex-shrink: 0; }
.addr-hint {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}

.add-btn {
  border: 4rpx dashed #dadce0;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  color: #9aa0a6;
  font-size: 28rpx;
  margin-top: 16rpx;
  background: #fafbfc;
  transition: border-color 0.15s;
}
.add-btn:active { border-color: #ff6b35; color: #ff6b35; }
.add-plus {
  font-size: 48rpx;
  display: block;
  line-height: 1;
  margin-bottom: 8rpx;
}

.exp-card {
  background: #fafbfc;
  border: 2rpx solid #eceff1;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  position: relative;
  transition: border-color 0.15s, background 0.15s;
}
.exp-card:active { border-color: #ffc9b3; background: #fff7f3; }
.exp-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  color: #bdc1c6;
  font-size: 28rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  transition: all 0.15s;
  z-index: 1;
}
.exp-del:active { background: #ffebee; color: #c62828; transform: scale(0.9); }
.exp-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}
.exp-name { font-size: 24rpx; color: #9aa0a6; }
.exp-info { font-size: 26rpx; color: #202124; }
.exp-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #eceff1;
  font-size: 24rpx;
  color: #5f6368;
}
.exp-price { color: #ff6b35; font-weight: 700; font-size: 30rpx; }

.row-input {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f6f8;
}
.row-input:last-of-type { border-bottom: none; padding-bottom: 8rpx; }
.row-input .lb {
  width: 180rpx;
  color: #5f6368;
  font-size: 26rpx;
  flex-shrink: 0;
}
.row-input .vl { flex: 1; font-size: 28rpx; }
.ph { color: #bdc1c6; }
.ta {
  width: 100%;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  min-height: 100rpx;
  margin-top: 8rpx;
  box-sizing: border-box;
  transition: background 0.15s;
}
.ta:focus { background: #fff; border: 2rpx solid #ffc9b3; }

.hint-line {
  font-size: 22rpx;
  color: #9aa0a6;
  padding: 8rpx 0 12rpx;
}

.price-card { background: linear-gradient(135deg, #fff7f3, #ffe8dc); }
.price-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #5f6368;
  margin-bottom: 8rpx;
}
.total-label { font-size: 44rpx; color: #ff6b35; font-weight: 700; }
.price-hint { font-size: 22rpx; color: #9aa0a6; }

.sticky-action {
  position: fixed;
  bottom: 140rpx;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 24rpx rgba(0, 0, 0, 0.08);
  border-top: 2rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 100;
}
.sticky-info {
  display: flex;
  flex-direction: column;
  color: #ff6b35;
  font-size: 36rpx;
  font-weight: 700;
  width: 200rpx;
}
.sticky-sub { font-size: 22rpx; color: #9aa0a6; font-weight: 400; }
.sticky-action .btn-primary { flex: 1; padding: 24rpx 0; }

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
  animation: fadeIn 0.2s;
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.sheet-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -16rpx 64rpx rgba(0, 0, 0, 0.25);
  z-index: 201;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 40rpx 32rpx 24rpx;
  color: #202124;
  position: relative;
}
.sheet-title::before {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 8rpx;
  background: #e8eaed;
  border-radius: 4rpx;
}
.sheet-scroll {
  max-height: 60vh;
  padding: 0 32rpx;
}
.sheet-wrap .confirm-btn {
  display: block;
  width: auto;
  margin: 32rpx 32rpx 0;
  padding: 0 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
}
.sheet-close {
  position: absolute;
  top: 40rpx;
  right: 32rpx;
  color: #bdc1c6;
  font-size: 36rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f6f8;
}

.sheet-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff7f3;
  color: #ff6b35;
  border: 2rpx solid #ffc9b3;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  transition: background 0.15s;
}
.sheet-switch:active { background: #ffe8dc; }
.sheet-switch .arr { color: #ff6b35; font-size: 28rpx; }

.input-sim {
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.15s, background 0.15s;
}
.input-sim:focus-within { border-color: #ffc9b3; background: #fff; }
.input-sim .lb {
  display: block;
  font-size: 22rpx;
  color: #9aa0a6;
  margin-bottom: 8rpx;
}
.input-sim .req { color: #ff6b35; }
.input-sim .pick-v {
  font-size: 28rpx;
  color: #202124;
}
.input-sim .tf {
  font-size: 28rpx;
  color: #202124;
}
.input-sim .def {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-left: 12rpx;
}

.quick-express {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.qe {
  background: #f5f6f8;
  color: #5f6368;
  border: 2rpx solid transparent;
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  transition: all 0.15s;
}
.qe.active {
  background: #fff7f3;
  color: #ff6b35;
  border-color: #ff6b35;
  font-weight: 500;
}

.ptype-label {
  font-size: 26rpx;
  color: #202124;
  font-weight: 600;
  margin: 20rpx 0 16rpx;
}
.ptype-pick-inline {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.ptype-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 24rpx;
  border-radius: 32rpx;
  background: #f5f6f8;
  border: 2rpx solid transparent;
  font-size: 24rpx;
  color: #5f6368;
  transition: all 0.15s;
}
.ptype-chip.active {
  border-color: #ff6b35;
  background: #fff7f3;
  color: #202124;
  transform: scale(1.02);
}
.chip-icon { font-size: 26rpx; }
.chip-name { font-weight: 500; }
.chip-price { color: #ff6b35; font-weight: 600; }

.chip-small.active { background: #f1f3f4; border-color: #9aa0a6; }
.chip-mid.active { background: #fff1eb; border-color: #ff6b35; }
.chip-big.active { background: #ffebee; border-color: #c62828; }
.chip-urgent.active { background: #fce4ec; border-color: #c2185b; }

.confirm-btn { margin-top: 28rpx; }

.scan-result {
  background: #fff7f3;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #ffc9b3;
}
.scan-title {
  color: #ff6b35;
  font-weight: 600;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}
.scan-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
}
.scan-row .sk { color: #9aa0a6; }
.scan-row .sv { color: #202124; font-weight: 500; }






.eta-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 999;
  max-height: 78vh;
  animation: slideUp 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
.eta-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #202124;
  margin-bottom: 20rpx;
  position: relative;
  padding: 8rpx 0 24rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.eta-sheet-title::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 8rpx;
  background: #e8eaed;
  border-radius: 4rpx;
}
.eta-sheet .sheet-close {
  position: absolute;
  top: 12rpx;
  right: 0;
  font-size: 36rpx;
  color: #bdc1c6;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f6f8;
  transition: background 0.15s;
}
.eta-sheet .sheet-close:active { background: #e8eaed; }
.eta-sheet-scroll { max-height: 62vh; padding-top: 8rpx; }

.eta-section { margin-bottom: 36rpx; }
.eta-section:last-child { margin-bottom: 0; }
.eta-section-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.section-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ddd;
}
.section-dot.quick-dot { background: #ff6b35; }

.eta-quick-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}
.eta-quick-card.active {
  background: #fff3e8;
  border-color: #ff6b35;
}
.quick-left { flex: 1; }
.quick-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}
.eta-quick-card.active .quick-label { color: #ff6b35; }
.quick-sub {
  font-size: 24rpx;
  color: #999;
}
.check-mark {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ff6b35;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.eta-slot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.eta-slot {
  width: calc(33.333% - 12rpx);
  padding: 20rpx 8rpx;
  background: #f5f6f8;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  transition: all 0.12s;
}
.eta-slot.active {
  background: #ff6b35;
  color: #fff;
  border-color: #ff6b35;
  font-weight: 600;
}
