.legal-page {
  padding: 32rpx 36rpx 80rpx;
  background: #fff;
  min-height: 100vh;
}
.doc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 12rpx;
}
.doc-update {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 48rpx;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-top: 40rpx;
  margin-bottom: 16rpx;
}
.sec-body {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  white-space: pre-wrap;
}
.doc-footer {
  margin-top: 60rpx;
  text-align: right;
  font-size: 24rpx;
  color: #999;
}
