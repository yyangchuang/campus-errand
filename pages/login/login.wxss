.login-page {
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.hero {
  padding: 120rpx 48rpx 80rpx;
  background: linear-gradient(180deg, #ff6b35 0%, #fff7f3 100%);
}
.brand { text-align: center; color: #fff; }
.logo {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 20rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 36rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}
.app-name { font-size: 44rpx; font-weight: 800; letter-spacing: 4rpx; margin-bottom: 8rpx; }
.app-sub { font-size: 24rpx; opacity: 0.85; }

.form-area {
  flex: 1;
  padding: 48rpx 48rpx 80rpx;
}

.btn-wx-main {
  display: flex;
  align-items: center;
  justify-content: center;
background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
  border: none;
  transition: background 0.12s, transform 0.12s;
}
.btn-wx-main:active { background: #06ad56; transform: scale(0.98); }
.btn-wx-main[disabled] { background: #9ca3af; color: #f3f4f6; }
.wx-t { letter-spacing: 2rpx; }

.btn-phone-entry {
  display: flex;
  align-items: center;
  justify-content: center;
color: #6b7280;
  font-size: 28rpx;
  padding: 24rpx 0;
  border-radius: 48rpx;
  border: 2rpx solid #e5e7eb;
  background: #fff;
  transition: all 0.12s;
}
.btn-phone-entry:active { background: #fafbfc; border-color: #d1d5db; color: #374151; }
.btn-phone-entry .arrow { color: #9ca3af; }

.phone-expand { margin-bottom: 24rpx; }
.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  position: relative;
}
.field-pfx {
  font-size: 28rpx;
  color: #6b7280;
  margin-right: 16rpx;
  padding-right: 16rpx;
  border-right: 2rpx solid #e5e7eb;
}
.field-in { flex: 1; font-size: 30rpx; color: #1f2937; }
.field-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: #e5e7eb;
  transition: background 0.2s;
}
.field.focus .field-bar { background: #ff6b35; height: 3rpx; }
.field.error .field-bar { background: #dc2626; }
.field-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: #9ca3af;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.field.shake { animation: shake 0.4s; }
@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  75% { transform: translateX(8rpx); }
}
.field-err {
  font-size: 22rpx;
  color: #dc2626;
  margin-top: 6rpx;
}

.code-btn {
  font-size: 26rpx;
  color: #ff6b35;
  padding-left: 20rpx;
  border-left: 2rpx solid #e5e7eb;
}
.code-btn.disabled { color: #9ca3af; }

.btn-phone-login {
  width: 100%;
  background: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-top: 24rpx;
  transition: background 0.12s, transform 0.12s;
}
.btn-phone-login:active { background: #e55a2b; transform: scale(0.98); }
.btn-phone-login.disabled { background: #d1d5db; color: #fff; }

.agree {
  display: flex;
  align-items: flex-start;
margin-top: 32rpx;
  font-size: 24rpx;
  color: #9ca3af;
}
.agree-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  flex-shrink: 0;
  margin-top: 2rpx;
  transition: all 0.12s;
}
.agree-box.on { background: #ff6b35; border-color: #ff6b35; }
.agree-txt { line-height: 1.5; }
.link { color: #ff6b35; }

.row-links {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(31, 41, 55, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 32rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #e5e7eb;
}
.sheet-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f3f4f6;
  margin-bottom: 16rpx;
}
.sheet-t { font-size: 30rpx; font-weight: 600; color: #1f2937; }
.sheet-x {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f4f6;
  border-radius: 12rpx;
  color: #9ca3af;
  font-size: 28rpx;
}
.dev-line {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
}
.dev-k { color: #9ca3af; }
.dev-v { color: #374151; font-family: "DIN Alternate", sans-serif; font-weight: 500; letter-spacing: 0.5rpx; }
