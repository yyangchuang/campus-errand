<view wx:if="{{order}}" class="page">
  <!-- 预计送达卡片 -->
  <view wx:if="{{showEta}}" class="eta-card {{isUrgent ? 'eta-urgent' : ''}}">
    <view class="eta-row">
      <text class="eta-icon">🚴</text>
      <view class="eta-body">
        <view class="eta-title">
          {{isDelivered ? '实际送达' : (isUrgent ? '急件优先配送' : '预计送达')}}
        </view>
        <view class="eta-time-line">
          <text class="eta-time-big">{{etaText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 顶部状态卡 -->
  <view class="detail-status {{isCancelled ? 'detail-status-cancel' : ''}}">
    <view class="dt-head">
      <view class="dt-tags">
        <text class="tag" style="background:rgba(255,255,255,.25);color:#fff">{{order.statusLabel}}</text>
        <text wx:if="{{order.takeMode === 'assign'}}" class="tag" style="background:rgba(255,255,255,.25);color:#fff">派单</text>
      </view>
      <text class="dt-price">¥{{order.total}}</text>
    </view>
    <view class="dt-title">{{order.stationName}} → {{order.address}}</view>
    <view class="dt-id">订单号 {{order.id}} · 共 {{order.packages.length}} 个快递</view>
  </view>

  <!-- 包裹清单 -->
  <view class="card">
    <view class="card-title">📦 要取的快递（{{order.packages.length}}个）</view>
    <view wx:for="{{order.packages}}" wx:key="index" class="pkg-row">
      <view class="pkg-left">
        <text class="ptype-tag {{item.ptype === 'small' ? 'ptype-small' : item.ptype === 'mid' ? 'ptype-mid' : item.ptype === 'big' ? 'ptype-big' : 'ptype-urgent'}}">{{item.ptype === 'small' ? '小' : item.ptype === 'mid' ? '中' : item.ptype === 'big' ? '大' : '急'}}</text>
        <text class="express-tag">{{item.express}}</text>
        <text class="pkg-name">{{item.name}}</text>
      </view>
      <text class="pkg-price">¥{{item.price}}</text>
    </view>
    <view class="pkg-total">
      <text>总计（已冻结）</text>
      <text class="price-label">¥{{order.total}}</text>
    </view>
  </view>

  <!-- 取件信息 -->
  <view class="card">
    <view class="card-title">🔐 取件信息（仅跑腿员可见）</view>
    <view wx:if="{{role === 'runner'}}" class="locked-area">
      <view wx:for="{{order.packages}}" wx:key="index" class="exp-card">
        <view class="exp-head">
          <text class="ptype-tag {{item.ptype === 'small' ? 'ptype-small' : item.ptype === 'mid' ? 'ptype-mid' : item.ptype === 'big' ? 'ptype-big' : 'ptype-urgent'}}">{{item.ptype === 'small' ? '小包裹' : item.ptype === 'mid' ? '中包裹' : item.ptype === 'big' ? '大包裹' : '急件'}}</text>
          <text class="express-tag">{{item.express}}</text>
        </view>
        <view class="exp-info">
          取件码 <text class="hl">{{item.code}}</text> · 尾号 <text class="hl">{{item.tail}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="locked-hint">🔒 取件码已加密，仅跑腿员可见</view>
  </view>

  <!-- 送达信息 -->
  <view class="card">
    <view class="card-title">🏠 送达信息</view>
    <view class="info-row"><text class="ic">●</text><text class="it">{{order.address}}</text></view>
    <view class="info-row" wx:if="{{order.note}}"><text class="il">备注</text><text>{{order.note}}</text></view>
  </view>

  <!-- 进度追踪 -->
  <view class="card progress-card">
    <view class="card-title">进度追踪</view>
    <view wx:for="{{flowSteps}}" wx:key="index" class="flow-item {{item.done && item.status !== 'cancelled' ? 'flow-done' : ''}} {{item.active && item.status !== 'cancelled' ? 'flow-active' : ''}} {{item.status === 'cancelled' ? 'flow-cancel' : ''}}">
      <view class="flow-dot"></view>
      <view class="flow-line" wx:if="{{index < flowSteps.length - 1}}"></view>
      <view class="flow-body">
        <view class="flow-lbl">{{item.label}}</view>
        <view wx:if="{{timelineLabels[item.status]}}" class="flow-time">{{timelineLabels[item.status]}}</view>
      </view>
    </view>
  </view>

  <!-- 送达凭证 -->
  <view wx:if="{{order.deliveryProof}}" class="card">
    <view class="card-title">📷 送达凭证</view>
    <image class="proof-img" src="{{order.deliveryProof}}" mode="widthFix" bindtap="previewProof" data-src="{{order.deliveryProof}}"></image>
    <view class="proof-tip">点击图片查看大图</view>
  </view>

  <!-- 联系 -->
  <view class="card">
    <view class="card-title">📞 联系</view>
    <view wx:if="{{runner}}" class="contact-row">
      <view class="contact-left">
        <view class="contact-avatar">🏃</view>
        <view>
          <view class="contact-name">{{runner.nickname}}</view>
          <view class="contact-sub">跑腿员 · 已完成 {{runner.stats.completeCount}} 单</view>
        </view>
      </view>
      <button class="call-btn" bindtap="callRunner">📞 联系</button>
    </view>
    <view wx:else class="empty-hint">还未接单</view>
  </view>

  <!-- 底部操作 -->
  <view wx:if="{{canCancel || canAccept || canDeliver || canArrive || canConfirm}}" class="detail-actions">
    <button wx:if="{{canCancel}}" class="btn-ghost" bindtap="cancel">取消订单</button>
    <button wx:if="{{canAccept}}" class="btn-primary" bindtap="accept">立即接单</button>
    <button wx:if="{{canDeliver}}" class="btn-primary" bindtap="deliver">已取件，开始运送</button>
    <button wx:if="{{canArrive}}" class="btn-primary" bindtap="arrive">已送达</button>
    <button wx:if="{{canConfirm}}" class="btn-primary" bindtap="confirm">确认签收</button>
  </view>
</view>
