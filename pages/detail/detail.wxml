<view wx:if="{{order}}" class="page">
  <view wx:if="{{showEta}}" class="eta-card {{isUrgent ? 'eta-urgent' : ''}}">
    <view class="eta-row">
      <image class="eta-icon" src="{{icons.bike_orange}}" mode="aspectFit" />
      <view class="eta-body">
        <view class="eta-title">
          <text>{{isDelivered ? '实际送达' : (isUrgent ? '急件优先配送' : '预计送达')}}</text>
        </view>
        <view class="eta-time-line">
          <text class="eta-time-big">{{etaText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="detail-status {{isCancelled ? 'detail-status-cancel' : ''}}">
    <view class="dt-head">
      <view class="dt-tags">
        <text class="tag" style="background:rgba(255,255,255,.25);color:#fff">{{order.statusLabel}}</text>
        <text wx:if="{{order.takeMode === 'assign'}}" class="tag" style="background:rgba(255,255,255,.25);color:#fff">派单</text>
      </view>
      <text class="dt-price">¥{{order.total}}</text>
    </view>
    <view class="dt-title"><text>{{order.stationName}} → {{order.address}}</text></view>
    <view class="dt-id"><text>订单号 {{order.id}} · 共 {{order.packages.length}} 个快递</text></view>
  </view>

  <view class="card">
    <view class="card-title">
      <image class="ci" src="{{icons.package_orange}}" mode="aspectFit" />
      <text>要取的快递（{{order.packages.length}}个）</text>
    </view>
    <view wx:for="{{order.packages}}" wx:key="index" class="pkg-row">
      <view class="pkg-left">
        <text class="tag {{item.ptype === 'small' ? 'tag-gray' : item.ptype === 'mid' ? 'tag-orange' : item.ptype === 'big' ? 'tag-red' : 'tag-orange'}}">{{item.ptype === 'small' ? '小' : item.ptype === 'mid' ? '中' : item.ptype === 'big' ? '大' : '急'}}</text>
        <text class="tag tag-gray">{{item.express}}</text>
        <text class="pkg-name">{{item.name}}</text>
      </view>
      <text class="pkg-price">¥{{item.price}}</text>
    </view>
    <view class="pkg-total">
      <text>总计（已冻结）</text>
      <text class="price-label">¥{{order.total}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">
      <image class="ci" src="{{icons.lock_gray}}" mode="aspectFit" />
      <text>取件信息（仅跑腿员可见）</text>
    </view>
    <view wx:if="{{role === 'runner'}}" class="locked-area">
      <view wx:for="{{order.packages}}" wx:key="index" class="exp-card">
        <view class="exp-head">
          <text class="tag {{item.ptype === 'small' ? 'tag-gray' : item.ptype === 'mid' ? 'tag-orange' : item.ptype === 'big' ? 'tag-red' : 'tag-orange'}}">{{item.ptype === 'small' ? '小包裹' : item.ptype === 'mid' ? '中包裹' : item.ptype === 'big' ? '大包裹' : '急件'}}</text>
          <text class="tag tag-gray">{{item.express}}</text>
        </view>
        <view class="exp-info">
          <text class="hl">取件码 {{item.code}}</text>
          <text> · </text>
          <text class="hl">尾号 {{item.tail}}</text>
        </view>
      </view>
    </view>
    <view wx:else class="locked-hint">
      <image class="lh-ic" src="{{icons.lock_gray}}" mode="aspectFit" />
      <text>取件码已加密，仅跑腿员可见</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">
      <image class="ci" src="{{icons.home_orange}}" mode="aspectFit" />
      <text>送达信息</text>
    </view>
    <view class="info-row">
      <image class="ic" src="{{icons.map_pin_orange}}" mode="aspectFit" />
      <text class="it">{{order.address}}</text>
    </view>
    <view wx:if="{{order.note}}" class="info-row">
      <text class="il">备注</text>
      <text>{{order.note}}</text>
    </view>
  </view>

  <view class="card progress-card">
    <view class="card-title"><text>进度追踪</text></view>
    <view wx:for="{{flowSteps}}" wx:key="index" class="flow-item {{item.done && item.status !== 'cancelled' ? 'flow-done' : ''}} {{item.active && item.status !== 'cancelled' ? 'flow-active' : ''}} {{item.status === 'cancelled' ? 'flow-cancel' : ''}}">
      <view class="flow-dot"></view>
      <view class="flow-line" wx:if="{{index < flowSteps.length - 1}}"></view>
      <view class="flow-body">
        <view class="flow-lbl"><text>{{item.label}}</text></view>
        <view wx:if="{{timelineLabels[item.status]}}" class="flow-time"><text>{{timelineLabels[item.status]}}</text></view>
      </view>
    </view>
  </view>

  <view wx:if="{{order.deliveryProof}}" class="card">
    <view class="card-title">
      <image class="ci" src="{{icons.camera_orange}}" mode="aspectFit" />
      <text>送达凭证</text>
    </view>
    <image class="proof-img" src="{{order.deliveryProof}}" mode="widthFix" bindtap="previewProof" data-src="{{order.deliveryProof}}"></image>
    <view class="proof-tip"><text>点击图片查看大图</text></view>
  </view>

  <view class="card">
    <view class="card-title">
      <image class="ci" src="{{icons.phone_orange}}" mode="aspectFit" />
      <text>联系</text>
    </view>
    <view wx:if="{{runner}}" class="contact-row">
      <view class="contact-left">
        <view class="contact-avatar">
          <image src="{{icons.runner_orange}}" mode="aspectFit" class="ca-ic" />
        </view>
        <view>
          <view class="contact-name"><text>{{runner.nickname}}</text></view>
          <view class="contact-sub"><text>跑腿员 · 已完成 {{runner.stats.completeCount}} 单</text></view>
        </view>
      </view>
      <button class="call-btn" bindtap="callRunner">
        <image class="cb-ic" src="{{icons.phone_gray}}" mode="aspectFit" />
        <text>联系</text>
      </button>
    </view>
    <view wx:else class="empty-hint"><text>还未接单</text></view>
  </view>

  <view wx:if="{{canCancel || canAccept || canDeliver || canArrive || canConfirm}}" class="detail-actions">
    <button wx:if="{{canCancel}}" class="btn-ghost" bindtap="cancel">取消订单</button>
    <button wx:if="{{canAccept}}" class="btn-primary" bindtap="accept">立即接单</button>
    <button wx:if="{{canDeliver}}" class="btn-primary" bindtap="deliver">已取件，开始运送</button>
    <button wx:if="{{canArrive}}" class="btn-primary" bindtap="arrive">已送达</button>
    <button wx:if="{{canConfirm}}" class="btn-primary" bindtap="confirm">确认签收</button>
  </view>
</view>
