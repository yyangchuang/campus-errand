.page { padding-bottom: calc(240rpx + env(safe-area-inset-bottom)); }

.eta-card {
  background: linear-gradient(135deg, #fff7f3, #ffe8dc);
  color: #202124;
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid #ffc9b3;
  transition: all 0.2s;
}
.eta-urgent {
  background: linear-gradient(135deg, #ff6b35, #ff3d00);
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 53, 0.4);
}
.eta-row { display: flex; align-items: center; gap: 20rpx; }
.eta-icon { font-size: 48rpx; }
.eta-body { flex: 1; }
.eta-title { font-size: 28rpx; opacity: 0.9; margin-bottom: 8rpx; }
.eta-time-big { font-size: 48rpx; font-weight: 700; margin-left: 12rpx; }
.eta-sub { font-size: 24rpx; opacity: 0.95; }
.eta-countdown { font-weight: 600; letter-spacing: 1rpx; }
.eta-overdue { color: #ffe0e0; font-weight: 600; }
.eta-delivered { color: #d4ffd4; }
.eta-hint { opacity: 0.8; }

.detail-status {
  background: linear-gradient(135deg, #ff7a4a, #ff5a20);
  color: #fff;
  border-radius: 0 0 32rpx 32rpx;
  padding: 56rpx 40rpx 48rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
  z-index: 1;
}
.detail-status-cancel {
  background: linear-gradient(135deg, #9aa0a6, #5f6368);
}
.dt-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.dt-tags { display: flex; gap: 12rpx; }
.dt-price { font-size: 52rpx; font-weight: 600; }
.dt-title { font-size: 32rpx; font-weight: 600; margin-top: 20rpx; }
.dt-id { font-size: 22rpx; opacity: 0.8; margin-top: 12rpx; }

.pkg-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f6f8;
}
.pkg-row:last-of-type { border-bottom: none; }
.pkg-left { display: flex; align-items: center; gap: 12rpx; flex: 1; flex-wrap: wrap; }
.pkg-name { font-size: 26rpx; color: #5f6368; }
.pkg-price { color: #ff6b35; font-weight: 600; font-size: 28rpx; }

.pkg-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #dadce0;
  font-size: 26rpx;
  color: #5f6368;
}
.price-label { font-size: 36rpx; color: #ff6b35; font-weight: 700; }

.locked-area { }
.locked-hint {
  background: linear-gradient(135deg, #f5f6f8, #e8eaed);
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 26rpx;
  color: #9aa0a6;
  text-align: center;
  border: 2rpx dashed #dadce0;
}

.exp-card {
  background: linear-gradient(135deg, #fafbfc, #f5f6f8);
  border: 2rpx solid #eceff1;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}
.exp-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; flex-wrap: wrap; }
.exp-info { font-size: 26rpx; color: #202124; }

.info-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
}
.info-row .ic { color: #1e8e3e; font-size: 20rpx; margin-right: 16rpx; width: 28rpx; }
.info-row .il { width: 120rpx; color: #9aa0a6; font-size: 26rpx; }

.progress-card { overflow: hidden; }

.flow-item {
  position: relative;
  padding-left: 56rpx;
  padding-bottom: 40rpx;
  font-size: 26rpx;
}
.flow-item:last-child { padding-bottom: 0; }
.flow-dot {
  position: absolute;
  left: 14rpx;
  top: 8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #dadce0;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #dadce0;
  z-index: 1;
}
.flow-done .flow-dot { background: #ff6b35; box-shadow: 0 0 0 2rpx #ff6b35; }
.flow-active .flow-dot {
  width: 30rpx; height: 30rpx; left: 10rpx;
  box-shadow: 0 0 0 8rpx rgba(255, 107, 53, .3);
  animation: pulse 1.5s infinite;
}
.flow-cancel .flow-dot { background: #5f6368; box-shadow: 0 0 0 2rpx #5f6368; width: 26rpx; height: 26rpx; left: 12rpx; top: 6rpx; border: 4rpx solid #fff; }

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 8rpx rgba(255, 107, 53, .3); }
  50% { box-shadow: 0 0 0 16rpx rgba(255, 107, 53, 0); }
}
.flow-line {
  position: absolute;
  left: 23rpx;
  top: 34rpx;
  width: 2rpx;
  height: calc(100% + 4rpx);
  background: #e8eaed;
}
.flow-done .flow-line { background: #ff6b35; }
.flow-cancel .flow-line { background: #9aa0a6; }

.flow-body { display: flex; flex-direction: column; gap: 4rpx; }
.flow-lbl { color: #9aa0a6; }
.flow-done .flow-lbl { color: #202124; font-weight: 500; }
.flow-active .flow-lbl { color: #ff6b35; font-weight: 600; }
.flow-cancel .flow-lbl { color: #5f6368; font-weight: 600; }

.flow-time {
  font-size: 22rpx;
  color: #bdc1c6;
}
.flow-done .flow-time { color: #9aa0a6; }
.flow-active .flow-time { color: #ff6b35; opacity: 0.8; }
.flow-cancel .flow-time { color: #9aa0a6; }

.contact-row { display: flex; justify-content: space-between; align-items: center; }
.contact-left { display: flex; align-items: center; gap: 20rpx; }
.contact-avatar {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: linear-gradient(135deg, #ffe8dc, #ffd0bb);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx;
}
.contact-name { font-size: 28rpx; font-weight: 500; }
.contact-sub { font-size: 22rpx; color: #9aa0a6; margin-top: 4rpx; }
.call-btn {
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
  padding: 14rpx 32rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  background: #fff;
  line-height: 1.4;
  transition: background 0.15s;
}
.call-btn:active { background: #fff7f3; }
.empty-hint {
  text-align: center;
  color: #9aa0a6;
  font-size: 26rpx;
  padding: 28rpx;
}
.proof-img {
  width: 100%;
  border-radius: 16rpx;
  background: #f5f5f5;
}
.proof-tip {
  text-align: center;
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 12rpx;
}

.detail-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 24rpx rgba(0, 0, 0, 0.08);
  border-top: 2rpx solid #f0f0f0;
  display: flex;
  gap: 20rpx;
  z-index: 100;
}
.detail-actions .btn-primary { flex: 2; padding: 24rpx 0; font-size: 30rpx; font-weight: 600; letter-spacing: 2rpx; box-shadow: 0 6rpx 20rpx rgba(255, 107, 53, 0.3); transition: transform 0.15s; }
.detail-actions .btn-primary:active { transform: scale(0.97); opacity: 1; }
.detail-actions .btn-ghost { flex: 1; padding: 24rpx 0; color: #5f6368; transition: all 0.15s; }
.detail-actions .btn-ghost:active { background: #ffebee; color: #c62828; border-color: #c62828; }
.eta-time-line { margin-top: 6rpx; }
