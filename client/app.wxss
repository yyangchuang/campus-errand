.ci { width: 36rpx; height: 36rpx; margin-right: 12rpx; flex-shrink: 0; }
.arr { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.sheet-close { width: 40rpx; height: 40rpx; }
.add-plus { width: 48rpx; height: 48rpx; }
.check-mark { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.exp-del { width: 36rpx; height: 36rpx; }
.chip-icon { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.sl-ic { width: 32rpx; height: 32rpx; margin-right: 10rpx; flex-shrink: 0; }
.ca-ic { width: 40rpx; height: 40rpx; }
.cb-ic { width: 26rpx; height: 26rpx; margin-right: 8rpx; }
.lh-ic { width: 32rpx; height: 32rpx; margin-right: 10rpx; opacity: 0.6; }
.ql-ic { width: 32rpx; height: 32rpx; margin-right: 8rpx; }
.sw-ic { width: 32rpx; height: 32rpx; margin-right: 10rpx; }
.sr-ic { width: 32rpx; height: 32rpx; margin-right: 10rpx; }
.hint-ic { width: 24rpx; height: 24rpx; margin-right: 6rpx; flex-shrink: 0; opacity: 0.6; }
.ic { width: 28rpx; height: 28rpx; margin-right: 10rpx; flex-shrink: 0; }
.eta-icon { width: 48rpx; height: 48rpx; flex-shrink: 0; }
.empty-emoji { width: 120rpx; height: 120rpx; margin-bottom: 16rpx; opacity: 0.5; }
.income-ic { width: 36rpx; height: 36rpx; margin-right: 10rpx; }
.wx-ic { width: 36rpx; height: 36rpx; margin-right: 12rpx; }
.pe-ic { width: 32rpx; height: 32rpx; margin-right: 10rpx; }
.field-clear { width: 32rpx; height: 32rpx; padding: 8rpx; flex-shrink: 0; }
.arrow { width: 28rpx; height: 28rpx; opacity: 0.5; }

page {
  background: #f8f9fa;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  margin: 16rpx 24rpx;
  padding: 28rpx;
  border: 2rpx solid #e5e7eb;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #1f2937;
  display: flex;
  align-items: center;
}

.btn-primary {
  display: block;
  width: 100%;
  background: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 52rpx;
  padding: 26rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 2rpx;
  transition: transform 0.12s, background 0.12s;
}
.btn-primary:active { background: #e55a2b; transform: scale(0.98); }

.btn-ghost {
  flex: 1;
  text-align: center;
  border: 2rpx solid #d1d5db;
  color: #6b7280;
  border-radius: 40rpx;
  padding: 18rpx 0;
  font-size: 26rpx;
  background: #fff;
  transition: background 0.12s, border-color 0.12s;
}
.btn-ghost:active { background: #f3f4f6; border-color: #9ca3af; }

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  line-height: 1.4;
  font-weight: 500;
}
.tag-orange { background: #fff7f3; color: #ff6b35; border: 2rpx solid #ffd4c2; }
.tag-blue { background: #eff6ff; color: #1d4ed8; border: 2rpx solid #bfdbfe; }
.tag-green { background: #ecfdf5; color: #059669; border: 2rpx solid #a7f3d0; }
.tag-gray { background: #f3f4f6; color: #6b7280; border: 2rpx solid #e5e7eb; }
.tag-red { background: #fef2f2; color: #dc2626; border: 2rpx solid #fecaca; }

.price {
  color: #ff6b35;
  font-weight: 700;
  font-family: "DIN Alternate", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: -0.5rpx;
}

.hl { color: #ff6b35; font-weight: 700; }

.empty {
  text-align: center;
  padding: 200rpx 80rpx calc(200rpx + env(safe-area-inset-bottom));
}
.empty-emoji {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
  flex-shrink: 0;
}
.empty-text {
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 24rpx;
  color: #9ca3af;
  display: block;
}

.btn-login-empty {
  width: 360rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin: 48rpx auto 0;
  transition: transform 0.12s, background 0.12s;
}
.btn-login-empty:active { background: #e55a2b; transform: scale(0.97); }
