.page { padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }

.eta-card {
  margin: 16rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #eff6ff;
  border-radius: 20rpx;
  border: 2rpx solid #bfdbfe;
}
.eta-card.eta-urgent {
  background: #fff7ed;
  border-color: #fed7aa;
}
.eta-row { display: flex; align-items: center; }
.eta-body { flex: 1; }
.eta-title { font-size: 24rpx; color: #6b7280; margin-bottom: 4rpx; font-weight: 500; }
.eta-time-big {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  font-family: "DIN Alternate", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: -0.5rpx;
}
.eta-card.eta-urgent .eta-time-big { color: #ea580c; }

.detail-status {
  margin: 16rpx 24rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #ff6b35, #e55a2b);
  border-radius: 20rpx;
  border: 2rpx solid #ff6b35;
  color: #fff;
}
.detail-status-cancel {
  background: #6b7280;
  border-color: #6b7280;
}
.dt-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12rpx; }
.dt-tags { display: flex; }
.dt-tags .tag { background: rgba(255,255,255,0.2); color: #fff; border: none; }
.dt-price {
  font-size: 52rpx;
  font-weight: 800;
  font-family: "DIN Alternate", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: -1rpx;
}
.dt-title { font-size: 30rpx; font-weight: 600; margin-bottom: 6rpx; }
.dt-id { font-size: 22rpx; opacity: 0.85; }

.pkg-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f3f4f6;
}
.pkg-row:last-of-type { border-bottom: none; }
.pkg-left { display: flex; align-items: center; flex: 1; }
.pkg-name { font-size: 24rpx; color: #6b7280; }
.pkg-price {
  font-size: 28rpx;
  color: #ff6b35;
  font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.pkg-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  margin-top: 8rpx;
  border-top: 2rpx solid #e5e7eb;
  font-size: 26rpx;
  color: #6b7280;
}
.price-label {
  font-size: 34rpx;
  color: #ff6b35;
  font-weight: 800;
  font-family: "DIN Alternate", sans-serif;
  letter-spacing: -0.5rpx;
}

.locked-area { margin-top: 8rpx; }
.locked-hint {
  text-align: center;
  padding: 40rpx;
  color: #9ca3af;
  font-size: 24rpx;
  background: #fafbfc;
  border-radius: 14rpx;
  border: 2rpx dashed #e5e7eb;
}
.exp-card {
  background: #fafbfc;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 10rpx;
}
.exp-head { display: flex; align-items: center; margin-bottom: 6rpx; flex-wrap: wrap; }
.exp-info { font-size: 26rpx; color: #1f2937; font-weight: 500; }

.info-row {
  display: flex;
  align-items: flex-start;
padding: 10rpx 0;
  font-size: 26rpx;
  color: #1f2937;
}
.info-row .ic { margin-top: 10rpx; flex-shrink: 0; }
.info-row .il { color: #9ca3af; font-size: 24rpx; width: 100rpx; flex-shrink: 0; }

.progress-card { padding-bottom: 20rpx; }
.flow-item {
  display: flex;
position: relative;
  padding-bottom: 24rpx;
}
.flow-item:last-child { padding-bottom: 0; }
.flow-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #d1d5db;
  border: 4rpx solid #f3f4f6;
  flex-shrink: 0;
  margin-top: 6rpx;
  z-index: 1;
}
.flow-done .flow-dot { background: #22c55e; border-color: #dcfce7; }
.flow-active .flow-dot { background: #ff6b35; border-color: #fff7f3; animation: pulse 1.5s ease-in-out infinite; }
.flow-cancel .flow-dot { background: #6b7280; border-color: #e5e7eb; }
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.3); }
}
.flow-line {
  position: absolute;
  left: 34rpx;
  top: 32rpx;
  width: 2rpx;
  height: calc(100% - 8rpx);
  background: #e5e7eb;
}
.flow-done .flow-line { background: #22c55e; }
.flow-cancel .flow-line { background: #9ca3af; }
.flow-body { flex: 1; padding-bottom: 4rpx; }
.flow-lbl { font-size: 28rpx; color: #374151; font-weight: 500; }
.flow-done .flow-lbl { color: #1f2937; }
.flow-active .flow-lbl { color: #ff6b35; font-weight: 600; }
.flow-cancel .flow-lbl { color: #6b7280; text-decoration: line-through; }
.flow-time { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }
.flow-cancel .flow-time { color: #6b7280; }

.proof-img { width: 100%; border-radius: 14rpx; border: 2rpx solid #e5e7eb; margin-top: 8rpx; }
.proof-tip { text-align: center; font-size: 22rpx; color: #9ca3af; margin-top: 10rpx; }

.contact-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.contact-left { display: flex; align-items: center; }
.contact-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff7f3;
  border: 2rpx solid #ffd4c2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.contact-name { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.contact-sub { font-size: 22rpx; color: #9ca3af; margin-top: 2rpx; }
.call-btn {
  background: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.call-btn:active { background: #e55a2b; }
.empty-hint { text-align: center; padding: 32rpx; color: #9ca3af; font-size: 24rpx; }

.detail-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 2rpx solid #e5e7eb;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
z-index: 100;
}
.detail-actions .btn-primary { flex: 1; padding: 22rpx 0; }
.detail-actions .btn-ghost { flex: 1; padding: 22rpx 0; }
