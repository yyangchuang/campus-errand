.page { padding-top: 48rpx; padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); }

.page-header {
  padding: 24rpx 32rpx 12rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.page-title { font-size: 34rpx; font-weight: 700; color: #1f2937; letter-spacing: -0.5rpx; }
.page-sub { font-size: 24rpx; color: #9ca3af; }

.tabs {
  display: flex;
  background: #fff;
  padding: 0 24rpx;
  border-bottom: 2rpx solid #e5e7eb;
}
.tabs .tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
  transition: color 0.12s;
}
.tabs .tab.active { color: #ff6b35; font-weight: 600; }
.tabs .tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #ff6b35;
  border-radius: 2rpx;
}

.order-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 12rpx 24rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #e5e7eb;
  transition: border-color 0.12s, background 0.12s;
}
.order-card:active { border-color: #ff6b35; background: #fff7f3; }

.oc-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
}
.oc-time { font-size: 22rpx; color: #9ca3af; }
.oc-reward {
  font-size: 44rpx;
  color: #ff6b35;
  font-weight: 800;
  font-family: "DIN Alternate", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: -1rpx;
}

.oc-route {
  background: #fafbfc;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  border: 2rpx solid #f3f4f6;
}
.route-r1 { margin-bottom: 4rpx; }
.dotg { color: #22c55e; font-size: 16rpx; margin-right: 10rpx; }
.doto { color: #ff6b35; font-size: 16rpx; margin-right: 10rpx; }

.oc-meta {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 12rpx;
  display: flex;
flex-wrap: wrap;
  align-items: center;
}
.pkg-tags { display: flex; }

.oc-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f3f4f6;
}
