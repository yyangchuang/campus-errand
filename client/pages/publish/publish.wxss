.page {
  padding: 48rpx 0 calc(200rpx + env(safe-area-inset-bottom));
}

.notice-bar {
  display: flex;
  align-items: center;
  margin: 0 24rpx 8rpx;
  padding: 20rpx 24rpx;
  background: #fff7f3;
  border-radius: 16rpx;
  border: 2rpx solid #ffd4c2;
}
.nb-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.nb-text { flex: 1; font-size: 24rpx; color: #9a3412; line-height: 1.5; }
.nb-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: transparent;
  transition: background 0.12s;
}
.nb-close:active { background: #ffe8dc; }

.row-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 30rpx;
  font-weight: 500;
}
.addr-hint {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 6rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx dashed #d1d5db;
  border-radius: 20rpx;
  padding: 32rpx;
  color: #6b7280;
  margin-top: 12rpx;
  background: #fafbfc;
  transition: border-color 0.12s, color 0.12s, background 0.12s;
}
.add-btn .add-plus { margin-right: 12rpx; }
.add-btn text { font-size: 28rpx; font-weight: 500; }
.add-btn:active { border-color: #ff6b35; color: #ff6b35; background: #fff7f3; }

.exp-card {
  background: #fff;
  border: 2rpx solid #e5e7eb;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-top: 12rpx;
  position: relative;
  transition: border-color 0.12s, background 0.12s;
}
.exp-card:active { border-color: #ff6b35; background: #fff7f3; }
.exp-del {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  transition: background 0.12s;
}
.exp-del:active { background: #fef2f2; }
.exp-head {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}
.exp-head .tag { margin-right: 10rpx; }
.exp-name { font-size: 24rpx; color: #6b7280; }
.exp-info { font-size: 26rpx; color: #1f2937; font-weight: 500; }
.exp-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx dashed #e5e7eb;
  font-size: 24rpx;
  color: #6b7280;
}

.row-input {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f3f4f6;
}
.row-input:last-of-type { border-bottom: none; padding-bottom: 6rpx; }
.row-input .lb {
  width: 180rpx;
  color: #6b7280;
  font-size: 26rpx;
  flex-shrink: 0;
}
.row-input .vl {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ph { color: #d1d5db; }
.ta {
  width: 100%;
  background: #fafbfc;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  min-height: 100rpx;
  margin-top: 8rpx;
  box-sizing: border-box;
  transition: border-color 0.12s, background 0.12s;
}
.ta:focus { background: #fff; border-color: #ff6b35; }

.price-card {
  background: #fff;
  border: 2rpx solid #ff6b35;
  border-radius: 20rpx;
}
.price-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 26rpx;
  color: #6b7280;
}
.total-label {
  font-size: 52rpx;
  color: #ff6b35;
  font-weight: 800;
  font-family: "DIN Alternate", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: -1rpx;
}
.price-hint { font-size: 22rpx; color: #9ca3af; margin-top: 6rpx; }

.sticky-action {
  position: fixed;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  left: 0;
  right: 0;
  background: #fff;
  border-top: 2rpx solid #e5e7eb;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  z-index: 100;
}
.sticky-info {
  display: flex;
  flex-direction: column;
  font-family: "DIN Alternate", -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  margin-right: 24rpx;
}
.sticky-info text:first-child {
  color: #ff6b35;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}
.sticky-sub { font-size: 22rpx; color: #9ca3af; font-family: "PingFang SC", sans-serif; }
.sticky-action .btn-primary { flex: 1; padding: 24rpx 0; border-radius: 44rpx; }

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(31, 41, 55, 0.5);
  z-index: 200;
}

.sheet-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 2rpx solid #e5e7eb;
  z-index: 201;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 36rpx 32rpx 20rpx;
  color: #1f2937;
  position: relative;
}
.sheet-title::before {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  background: #d1d5db;
  border-radius: 3rpx;
}
.sheet-scroll {
  max-height: 60vh;
  padding: 0 32rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}
.sheet-wrap .confirm-btn {
  display: block;
  width: auto;
  margin: 24rpx 32rpx 0;
  padding: 0 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  text-align: center;
}
.sheet-close {
  background: transparent;
  transition: background 0.12s;
  position: absolute;
  top: 32rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}
.sheet-close:active { background: #fff7f3; }

.sheet-switch {
  display: flex;
  align-items: center;
  background: #fff;
  color: #ff6b35;
  border: 2rpx solid #ff6b35;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  font-weight: 500;
  overflow: hidden;
}
.sheet-switch .sw-ic,
.sheet-switch .arr { flex-shrink: 0; }
.sheet-switch text {
  flex: 1;
  margin: 0 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}
.sheet-switch:active { background: #fff7f3; }

.input-sim {
  background: #fafbfc;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 14rpx;
  transition: border-color 0.12s, background 0.12s;
}
.input-sim:focus-within { border-color: #ff6b35; background: #fff; }
.input-sim .lb { display: block; font-size: 22rpx; color: #9ca3af; margin-bottom: 6rpx; }
.input-sim .req { color: #dc2626; }
.input-sim .pick-v { font-size: 28rpx; color: #1f2937; }
.input-sim .tf { font-size: 28rpx; color: #1f2937; }
.input-sim .def { font-size: 22rpx; color: #9ca3af; margin-left: 12rpx; }

.quick-express {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.quick-express .qe {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.qe {
  background: #fafbfc;
  color: #6b7280;
  border: 2rpx solid #e5e7eb;
  border-radius: 24rpx;
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  transition: all 0.12s;
}
.qe.active {
  background: #fff7f3;
  color: #ff6b35;
  border-color: #ff6b35;
  font-weight: 600;
}

.ptype-label {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 600;
  margin: 18rpx 0 14rpx;
}
.ptype-pick-inline {
  display: flex;
  flex-wrap: wrap;
}
.ptype-pick-inline .ptype-chip {
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.ptype-chip {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  border-radius: 28rpx;
  background: #fafbfc;
  border: 2rpx solid #e5e7eb;
  font-size: 24rpx;
  color: #6b7280;
  transition: all 0.12s;
}
.ptype-chip.active {
  border-color: #ff6b35;
  background: #fff7f3;
  color: #1f2937;
}
.chip-name { font-weight: 500; margin-left: 6rpx; }
.chip-price { color: #ff6b35; font-weight: 700; font-family: "DIN Alternate", sans-serif; margin-left: 8rpx; }

.chip-small.active { background: #fff7f3; border-color: #ff6b35; }
.chip-mid.active { background: #fff7f3; border-color: #ff6b35; }
.chip-big.active { background: #fef2f2; border-color: #dc2626; }
.chip-urgent.active { background: #fef3c7; border-color: #f59e0b; }

.scan-result {
  background: #fff;
  border: 2rpx solid #22c55e;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.scan-title {
  display: flex;
  align-items: center;
  color: #22c55e;
  font-weight: 600;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}
.scan-row { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 26rpx; }
.scan-row .sk { color: #9ca3af; }
.scan-row .sv { color: #1f2937; font-weight: 500; }

.eta-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 2rpx solid #e5e7eb;
  padding: 24rpx 32rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 999;
  max-height: 78vh;
  animation: slideUp 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
.eta-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 20rpx;
  position: relative;
  padding: 8rpx 0 20rpx;
  border-bottom: 2rpx solid #f3f4f6;
}
.eta-sheet-title::before {
  content: '';
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 6rpx;
  background: #d1d5db;
  border-radius: 3rpx;
}
.eta-sheet .sheet-close {
  background: transparent;
  transition: background 0.12s;
  position: absolute;
  top: 8rpx;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}
.eta-sheet-scroll { max-height: 62vh; padding-top: 8rpx; }

.eta-section { margin-bottom: 32rpx; }
.eta-section:last-child { margin-bottom: 0; }
.eta-section-title {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  font-weight: 500;
}
.eta-section-title text { margin-left: 10rpx; }
.section-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d1d5db;
  display: inline-block;
  flex-shrink: 0;
}
.section-dot.quick-dot { background: #ff6b35; }

.eta-quick-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #fafbfc;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  transition: all 0.12s;
}
.eta-quick-card.active {
  background: #fff7f3;
  border-color: #ff6b35;
}
.quick-left { flex: 1; }
.quick-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
}
.eta-quick-card.active .quick-label { color: #ff6b35; }
.quick-sub { font-size: 24rpx; color: #9ca3af; }
.check-mark {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ff6b35;
  flex-shrink: 0;
}

.eta-slot-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.eta-slot {
  width: calc(33.333% - 12rpx);
  padding: 18rpx 8rpx;
  background: #fafbfc;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  text-align: center;
  font-size: 26rpx;
  color: #374151;
  box-sizing: border-box;
  margin-bottom: 12rpx;
  transition: all 0.12s;
}
.eta-slot.active {
  background: #ff6b35;
  color: #fff;
  border-color: #ff6b35;
  font-weight: 600;
}
