<view class="tabbar">
  <view class="tab-item {{item.selected ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="pagePath" data-path="{{item.pagePath}}" data-idx="{{index}}" bindtap="switchTab">
    <image class="icon" src="{{item.icon}}" mode="aspectFit" />
    <text class="text">{{item.text}}</text>
  </view>
</view>
