.tabbar {
  display: flex;
  height: 100%;
  width: 100%;
  border-top: 1rpx solid #eceff1;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #fff;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #9aa0a6;
  gap: 6rpx;
  transition: color 0.15s;
  position: relative;
}
.tab-item.active {
  color: #ff6b35;
}
.tab-item.active .icon {
  transform: scale(1.15);
  transition: transform 0.15s;
}
.tab-item:active { background: #fafbfc; }
.icon {
  font-size: 44rpx;
  transition: transform 0.15s;
}
.text {
  font-size: 22rpx;
  font-weight: 500;
}
