.tabbar {
  display: flex;
  height: 100%;
  width: 100%;
  border-top: 2rpx solid #e5e7eb;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #fff;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
transition: color 0.15s;
  position: relative;
}
.tab-item.active { color: #ff6b35; }
.tab-item:active { background: #fafbfc; }
.icon {
  width: 44rpx;
  height: 44rpx;
  transition: transform 0.15s;
}
.tab-item.active .icon { transform: scale(1.15); }
.text {
  font-size: 22rpx;
  font-weight: 500;
}
